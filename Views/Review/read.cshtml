                <td>To Pimp a Butterfly</td>
                <td>Kendrick Lamar</td>
                <td>2015</td>
                <td>⭐⭐⭐⭐⭐</td>
            </tr>
            <tr>
                <td>3</td>
                <td>Currents</td>
                <td>Tame Impala</td>
